---
import "../styles/global.css";
if (Astro.locals.user) {
    return Astro.redirect("/");
}
---
<html lang="en" data-theme="nord">
    <head>
        <title>Login</title>
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-500 to-indigo-600">
        <div class="card w-full max-w-md shadow-2xl bg-base-100">
            <div class="card-body">
                <h1 class="card-title text-4xl font-bold mb-6 text-center text-primary">
                    Connexion
                </h1>
                <form id="login-form" class="flex flex-col gap-6">
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text">Email</span>
                        </label>
                        <input 
                            type="email" 
                            name="email" 
                            placeholder="Entrez votre email" 
                            required 
                            class="input input-bordered" 
                        />
                    </div>
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text">Mot de passe</span>
                        </label>
                        <input 
                            type="password" 
                            name="password" 
                            placeholder="Entrez votre mot de passe" 
                            required 
                            class="input input-bordered" 
                        />
                    </div>
                    <button type="submit" class="btn btn-primary w-full">
                        Se connecter
                    </button>
                </form>
                <p id="status" class="mt-4 text-center text-error"></p>
                <div class="divider">OU</div>
                <div class="text-center">
                    <a href="/signup" class="link link-primary">
                        Pas encore de compte ? <span class="font-bold">S'inscrire</span>
                    </a>
                </div>
            </div>
        </div>
    </body>
</html>

<script>
    //@ts-nocheck
    localStorage.removeItem("user");
    
    const form = document.getElementById("login-form");
    const status = document.getElementById("status");

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(form);

        const res = await fetch("/api/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                email: formData.get("email"),
                password: formData.get("password"),
            }),
            credentials: "include",
        });

        if (res.ok) {
            const resData = await res.json();
            localStorage.setItem("user", JSON.stringify(resData.user));
            status.textContent = "✅ Connexion réussie !";
            status.className = "mt-4 text-center text-success";
            setTimeout(() => {
                window.location.href = "/";
            }, 500);
        } else {
            status.textContent = "❌ Email ou mot de passe invalide";
            status.className = "mt-4 text-center text-error";
        }
    });
</script>
