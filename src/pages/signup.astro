---
import "../styles/global.css";
if (Astro.locals.user) {
    return Astro.redirect("/");
}
---
<html lang="en" data-theme="nord">
    <head>
        <title>Inscription</title>
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-500 to-indigo-600">
        <div class="card w-full max-w-lg shadow-2xl bg-base-100">
            <div class="card-body">
                <h1 class="card-title text-4xl font-bold mb-6 text-center text-primary">
                    Créez votre compte
                </h1>
                <form id="signup-form" class="flex flex-col gap-6">
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text">Nom</span>
                        </label>
                        <input 
                            type="text" 
                            name="name" 
                            placeholder="Entrez votre nom" 
                            required 
                            class="input input-bordered" 
                        />
                    </div>
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text">Email</span>
                        </label>
                        <input 
                            type="email" 
                            name="email" 
                            placeholder="Entrez votre email" 
                            required 
                            class="input input-bordered" 
                        />
                    </div>
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text">Mot de passe</span>
                        </label>
                        <input 
                            type="password" 
                            name="password" 
                            placeholder="Mot de passe (min. 8 caractères)" 
                            required 
                            minlength="8"
                            class="input input-bordered" 
                        />
                    </div>
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text">Confirmer le mot de passe</span>
                        </label>
                        <input 
                            type="password" 
                            name="passwordConfirm" 
                            placeholder="Confirmez votre mot de passe" 
                            required 
                            minlength="8"
                            class="input input-bordered" 
                        />
                    </div>
                    <button type="submit" class="btn btn-primary w-full mt-4">
                        S'inscrire
                    </button>
                </form>
                <p id="status" class="mt-4 text-center"></p>
                
                <div class="text-center mt-6">
                    <a href="/login" class="link link-primary">
                        Déjà un compte ? Se connecter
                    </a>
                </div>
            </div>
        </div>
    </body>
</html>

<script>
    const form = document.getElementById("signup-form");
    const status = document.getElementById("status");

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(form);

        const password = formData.get("password");
        const passwordConfirm = formData.get("passwordConfirm");

        if (password !== passwordConfirm) {
            status.textContent = "❌ Les mots de passe ne correspondent pas";
            status.className = "mt-4 text-center text-error";
            return;
        }

        const res = await fetch("/api/signup", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                name: formData.get("name"),
                email: formData.get("email"),
                password: password,
                passwordConfirm: passwordConfirm,
            }),
        });

        if (res.ok) {
            status.textContent = "✅ Inscription réussie ! Redirection vers la page de connexion...";
            status.className = "mt-4 text-center text-success";
            setTimeout(() => {
                window.location.href = "/login";
            }, 1500);
        } else {
            const error = await res.json();
            status.textContent = `❌ ${error.error || "Erreur lors de l'inscription"}`;
            status.className = "mt-4 text-center text-error";
        }
    });
</script>
