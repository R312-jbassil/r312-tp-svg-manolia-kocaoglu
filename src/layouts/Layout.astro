---
import "../styles/global.css";
import { ui } from "../i18n/ui.js";

const locale = Astro.locals.lang as 'en' | 'fr' ?? 'en';
const user = Astro.locals.user;
console.log('Locale in index:', locale);
console.log('User:', user);
---
<!doctype html>
<html lang="en" class="h-full" data-theme="nord">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class="h-full">
		<div class="flex items-center justify-between bg-base-200 shadow-lg rounded-lg p-4">
			<ul class="menu menu-horizontal flex gap-4">
				<li>
					<a href="/" class="text-lg font-semibold hover:text-primary">{ui[locale].nav.home}</a>
				</li>
				<li>
					<a href="generate" class="text-lg font-semibold hover:text-primary">{ui[locale].nav.generator}</a>
				</li>
				<li>
					<a href="gallery" class="text-lg font-semibold hover:text-primary">{ui[locale].nav.gallery}</a>
				</li>
				<form method="POST" action={Astro.url.pathname} class="ml-4">
					<select name="language" class="select select-bordered" onchange="this.form.submit()">
						<option disabled selected>Language</option>
						<option value="en">English</option>
						<option value="fr">Français</option>
					</select>
				</form>
			</ul>
			<div class="flex gap-2">
				{user ? (
					<form method="POST" action="/api/logout" class="m-0 p-0">
						<button type="submit" class="btn btn-primary btn-sm">Logout</button>
					</form>
				) : (
					<>
						<a href="/login" class="btn btn-secondary btn-sm">Login</a>
						<a href="/signup" class="btn btn-primary btn-sm">Sign Up</a>
					</>
				)}
			</div>
		</div>
		<div class="h-full flex flex-col min-h-0">
			<div class="flex-1 min-h-0">
				<slot />
			</div>
		</div>

	</body>
</html>